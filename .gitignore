!/data/contacts.csv
!/outputs/
/outputs/*
!/outputs/kuwait-directory-2026-10-24/
/outputs/kuwait-directory-2026-10-24/*
!/outputs/kuwait-directory-2026-10-24/kuwait-company-directory.xlsx
!/outputs/kuwait-directory-2026-10-24/kuwait-companies.sqlite
